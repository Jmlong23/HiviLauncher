<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:pq="urn:schemas-wiimu-com:metadata-1-0/PlayQueue/"
           targetNamespace="urn:schemas-wiimu-com:metadata-1-0/PlayQueue/"
           elementFormDefault="qualified">
    <xs:element name="Event">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="pq:QueueID" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="QueueID">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="CurrentPlayListName">
                    <xs:complexType><xs:attribute name="val" type="xs:string" use="required"/></xs:complexType>
                </xs:element>
                <xs:element name="LoopMode" type="pq:UnsignedValue"/>
                <xs:element name="CurrentIndex" type="pq:UnsignedValue"/>
            </xs:choice>
            <xs:attribute name="val" type="xs:unsignedInt" use="required"/>
        </xs:complexType>
    </xs:element>
    <xs:complexType name="UnsignedValue">
        <xs:attribute name="val" type="xs:unsignedInt" use="required"/>
    </xs:complexType>
</xs:schema>
