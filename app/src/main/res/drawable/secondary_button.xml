<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#333438" />
            <stroke android:width="1dp" android:color="#45474B" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#46484D" />
            <stroke android:width="1dp" android:color="#72757A" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2C2D31" />
            <stroke android:width="1dp" android:color="#4C4E52" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</selector>
