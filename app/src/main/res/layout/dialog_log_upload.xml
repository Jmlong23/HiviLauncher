<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="520dp"
    android:layout_height="280dp"
    android:background="@drawable/dialog_background"
    android:measureAllChildren="true">

    <LinearLayout
        android:id="@+id/log_upload_confirmation_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="44dp"
        android:paddingRight="44dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/log_upload_confirm_title"
            android:textColor="@color/text_color"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="46dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/log_upload_cancel"
                android:layout_width="118dp"
                android:layout_height="36dp"
                android:background="@drawable/secondary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/auth_cancel_action"
                android:textColor="@color/text_color"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/log_upload_confirm"
                android:layout_width="118dp"
                android:layout_height="36dp"
                android:layout_marginLeft="48dp"
                android:background="@drawable/primary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/log_upload_confirm_action"
                android:textColor="@color/text_color"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/log_upload_progress_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="56dp"
        android:paddingRight="56dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/settings_log_upload"
            android:textColor="@color/text_color"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/log_upload_progress_percent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/log_upload_progress_initial_percent"
            android:textColor="#4C8EFF"
            android:textSize="35sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/log_upload_progress_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/log_upload_preparing"
            android:textColor="@color/text_color"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/log_upload_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="30dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/system_update_progress" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/log_upload_success_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_success" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/log_upload_success_title"
            android:textColor="@color/text_color"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/log_upload_success_message"
            android:textColor="@color/text_color2"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
