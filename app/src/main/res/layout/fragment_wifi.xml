<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/music_row_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.142" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/music_row_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.858" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/music_row_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.2633" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/home_divider_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.6667" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/home_actions_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.7667" />

        <LinearLayout
            android:id="@+id/btn_qq_music"
            style="@style/MainMusicShortcut"
            android:contentDescription="@string/wifi_music_app_qq"
            app:layout_constraintEnd_toStartOf="@id/btn_wyy_music"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="@id/music_row_start"
            app:layout_constraintTop_toTopOf="@id/music_row_top">

            <FrameLayout style="@style/MainMusicTile">
                <ImageView
                    style="@style/MainMusicIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_qq" />
            </FrameLayout>

            <TextView
                style="@style/MainMusicLabel"
                android:text="@string/wifi_music_app_qq" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_wyy_music"
            style="@style/MainMusicShortcut"
            android:contentDescription="@string/wifi_music_app_wyy"
            app:layout_constraintEnd_toStartOf="@id/btn_kugou_music"
            app:layout_constraintStart_toEndOf="@id/btn_qq_music"
            app:layout_constraintTop_toTopOf="@id/music_row_top">

            <FrameLayout style="@style/MainMusicTile">
                <ImageView
                    style="@style/MainMusicIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_wyy" />
            </FrameLayout>

            <TextView
                style="@style/MainMusicLabel"
                android:text="@string/main_music_app_wyy" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_kugou_music"
            style="@style/MainMusicShortcut"
            android:contentDescription="@string/wifi_music_app_kugou"
            app:layout_constraintEnd_toStartOf="@id/btn_we_sing"
            app:layout_constraintStart_toEndOf="@id/btn_wyy_music"
            app:layout_constraintTop_toTopOf="@id/music_row_top">

            <FrameLayout style="@style/MainMusicTile">
                <ImageView
                    style="@style/MainMusicIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_kugou" />
            </FrameLayout>

            <TextView
                style="@style/MainMusicLabel"
                android:text="@string/wifi_music_app_kugou" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_we_sing"
            style="@style/MainMusicShortcut"
            android:contentDescription="@string/preset_app_we_sing"
            app:layout_constraintEnd_toStartOf="@id/music_row_end"
            app:layout_constraintStart_toEndOf="@id/btn_kugou_music"
            app:layout_constraintTop_toTopOf="@id/music_row_top">

            <FrameLayout style="@style/MainMusicTile">
                <ImageView
                    style="@style/MainMusicIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_kge" />
            </FrameLayout>

            <TextView
                style="@style/MainMusicLabel"
                android:text="@string/preset_app_we_sing" />
        </LinearLayout>

        <ImageView
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/line"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/home_divider_top"
            app:layout_constraintWidth_percent="0.602" />

        <LinearLayout
            android:id="@+id/home_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/home_actions_top">

            <LinearLayout
                android:id="@+id/btn_home_settings"
                style="@style/MainHomeAction">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_settings" />

                <TextView
                    style="@style/MainHomeActionLabel"
                    android:text="@string/settings_title" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_home_apps"
                style="@style/MainHomeAction"
                android:layout_marginStart="26dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_app" />

                <TextView
                    style="@style/MainHomeActionLabel"
                    android:text="@string/main_bottom_navigation_apps" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="106dp"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/player_card"
                android:layout_width="match_parent"
                android:layout_height="99dp"
                android:background="@drawable/bluetooth_page_long_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_alignParentBottom="true"
                android:paddingRight="15dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="129dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/track_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/wifi_music_no_playback"
                        android:textColor="@color/white"
                        android:textSize="21sp" />

                    <TextView
                        android:id="@+id/track_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/wifi_music_unknown_artist"
                        android:textColor="@color/text_color2"
                        android:textSize="19sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_previous_song"
                    android:layout_width="47dp"
                    android:layout_height="47dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/music_previous"
                    android:src="@drawable/ic_play_prv"
                    android:layout_marginRight="21dp"/>
                <ImageView
                    android:id="@+id/btn_play_or_pause"
                    android:layout_width="47dp"
                    android:layout_height="47dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/wifi_music_play"
                    android:src="@drawable/ic_play" />
                <ImageView
                    android:id="@+id/btn_next_song"
                    android:layout_width="47dp"
                    android:layout_height="47dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_play_next"
                    android:layout_marginLeft="21dp"/>
            </LinearLayout>
            <RelativeLayout
                android:layout_width="77dp"
                android:layout_height="96dp"
                android:layout_marginLeft="18dp"
                android:background="@drawable/album_placeholder">
                <ImageView
                    android:id="@+id/album_artwork"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/avatar_placeholder"
                    android:scaleType="centerCrop"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="41dp"
                    android:contentDescription="@string/wifi_music_album_art"/>
            </RelativeLayout>

        </RelativeLayout>

</FrameLayout>
