<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="37dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:layout_width="139dp"
            android:layout_height="0.5dp"
            android:layout_marginEnd="14dp"
            android:background="@color/line_color" />

        <TextView
            android:id="@+id/page_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_color"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="139dp"
            android:layout_height="0.5dp"
            android:layout_marginStart="14dp"
            android:background="@color/line_color" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="500dp"
        android:layout_height="278dp"
        android:layout_marginTop="30dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="474dp"
            android:layout_height="140dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/btn_qq_music"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/wifi_music_qq_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="bottom|center_horizontal"
                android:text="@string/wifi_music_app_qq"
                android:textColor="@color/text_color"
                android:textSize="13sp"
                android:layout_marginRight="27dp"
                android:paddingBottom="12dp"/>


            <TextView
                android:id="@+id/btn_wyy_music"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/wifi_music_wyy_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="bottom|center_horizontal"
                android:text="@string/wifi_music_app_wyy"
                android:textColor="@color/text_color"
                android:textSize="13sp"
                android:layout_marginRight="27dp"
                android:paddingBottom="12dp"/>

            <TextView
                android:id="@+id/btn_kugou_music"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/wifi_music_kugou_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="bottom|center_horizontal"
                android:text="@string/wifi_music_app_kugou"
                android:textColor="@color/text_color"
                android:textSize="13sp"
                android:paddingBottom="12dp" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="106dp"
            android:layout_marginTop="29dp">
            <LinearLayout
                android:id="@+id/player_card"
                android:layout_width="match_parent"
                android:layout_height="99dp"
                android:background="@drawable/bluetooth_page_long_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_alignParentBottom="true"
                android:paddingRight="15dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="129dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/track_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/wifi_music_no_playback"
                        android:textColor="@color/white"
                        android:textSize="21sp" />

                    <TextView
                        android:id="@+id/track_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/wifi_music_unknown_artist"
                        android:textColor="@color/text_color2"
                        android:textSize="19sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_play_or_pause"
                    android:layout_width="47dp"
                    android:layout_height="47dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/wifi_music_play"
                    android:src="@drawable/ic_play" />
                <ImageView
                    android:id="@+id/btn_next_song"
                    android:layout_width="47dp"
                    android:layout_height="47dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_play_next"
                    android:layout_marginLeft="21dp"/>
            </LinearLayout>
            <RelativeLayout
                android:layout_width="77dp"
                android:layout_height="96dp"
                android:layout_marginLeft="18dp"
                android:background="@drawable/album_placeholder">
                <ImageView
                    android:id="@+id/album_artwork"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/avatar_placeholder"
                    android:scaleType="centerCrop"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="41dp"
                    android:contentDescription="@string/wifi_music_album_art"/>
            </RelativeLayout>

        </RelativeLayout>

    </LinearLayout>
</LinearLayout>
