<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/apps_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#363636"
    android:orientation="vertical"
    android:paddingLeft="54dp"
    android:paddingTop="30dp"
    android:paddingRight="54dp">

    <LinearLayout
        android:id="@+id/apps_dialog_header"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/apps_back_button"
            android:layout_width="156dp"
            android:layout_height="match_parent"
            android:background="@drawable/main_status_pill_background"
            android:clickable="true"
            android:contentDescription="@string/main_bottom_navigation_back"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/apps_back_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/system_apps_back_icon" />

            <TextView
                android:id="@+id/apps_back_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:text="@string/main_bottom_navigation_back"
                android:textColor="@color/text_color"
                android:textSize="26sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/apps_volume_button"
            android:layout_width="132dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="28dp"
            android:background="@drawable/main_status_pill_background"
            android:clickable="true"
            android:contentDescription="@string/main_volume_adjust"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/apps_volume_icon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_volume" />

            <TextView
                android:id="@+id/apps_volume_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:text="@string/main_volume_placeholder"
                android:textColor="@color/text_color"
                android:textSize="26sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/apps_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="56dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:scrollbars="none">

        <GridLayout
            android:id="@+id/apps_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="5" />
    </ScrollView>
</LinearLayout>
