<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flip_screen_saver_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_clock_flip"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:clickable="true"
    android:focusable="true">
    <com.hivi.launcher.customview.FlipLayout
        android:id="@+id/flip_screen_saver_hour"
        android:layout_width="284dp"
        android:layout_height="335dp"
        android:layout_marginLeft="89dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="9dp"
        app:cardElevation="16dp"
        app:cardMaxElevation="22dp"
        app:cardUseCompatPadding="true"
        app:flipTextBackground="@drawable/flip_clock_card"
        app:flipTextColor="#272727"
        app:flipTextSize="185sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>

    <com.hivi.launcher.customview.FlipLayout
        android:id="@+id/flip_screen_saver_minute"
        android:layout_width="284dp"
        android:layout_height="335dp"
        android:layout_marginLeft="-35dp"
        app:cardCornerRadius="9dp"
        app:cardElevation="16dp"
        app:cardMaxElevation="22dp"
        app:cardUseCompatPadding="true"
        app:flipTextBackground="@drawable/flip_clock_card"
        app:flipTextColor="#272727"
        app:flipTextSize="185sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@id/flip_screen_saver_hour"/>

    <com.hivi.launcher.customview.FlipLayout
        android:id="@+id/flip_screen_saver_second"
        android:layout_width="136dp"
        android:layout_height="167dp"
        android:layout_marginLeft="-35dp"
        app:cardCornerRadius="9dp"
        app:cardElevation="16dp"
        app:cardMaxElevation="22dp"
        app:cardUseCompatPadding="true"
        app:flipTextBackground="@drawable/flip_clock_card"
        app:flipTextColor="#272727"
        app:flipTextSize="69sp"
        app:layout_constraintBottom_toBottomOf="@+id/flip_screen_saver_minute"
        app:layout_constraintLeft_toRightOf="@id/flip_screen_saver_minute"/>

    <ImageView
        android:id="@+id/timeline_hour"
        android:layout_width="236dp"
        android:layout_height="26dp"
        android:background="@drawable/flip_clock_timeline"
        android:elevation="16dp"
        android:layout_marginLeft="113dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>

    <ImageView
        android:id="@+id/timeline_minute"
        android:layout_width="236dp"
        android:layout_height="26dp"
        android:background="@drawable/flip_clock_timeline"
        android:elevation="16dp"
        android:layout_marginLeft="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/flip_screen_saver_minute"
        app:layout_constraintTop_toTopOf="@id/flip_screen_saver_minute"
        app:layout_constraintLeft_toRightOf="@+id/timeline_hour"/>

    <ImageView
        android:id="@+id/timeline_second"
        android:layout_width="88dp"
        android:layout_height="13dp"
        android:background="@drawable/flip_clock_timeline"
        android:elevation="16dp"
        android:layout_marginLeft="13dp"
        app:layout_constraintBottom_toBottomOf="@+id/flip_screen_saver_second"
        app:layout_constraintTop_toTopOf="@id/flip_screen_saver_second"
        app:layout_constraintLeft_toRightOf="@+id/timeline_minute"/>

    <TextView
        android:id="@+id/flip_screen_saver_ampm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/flip_clock_font"
        android:text="AM"
        android:textColor="#6F6F6F"
        android:textSize="27sp"
        android:elevation="16dp"
        android:layout_marginTop="72dp"
        android:layout_marginRight="10dp"
        app:layout_constraintTop_toBottomOf="@+id/timeline_minute"
        app:layout_constraintRight_toRightOf="@+id/timeline_minute"/>

    <LinearLayout
        android:layout_width="127dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginLeft="40dp"
        android:layout_marginBottom="54dp"
        app:layout_constraintLeft_toRightOf="@+id/timeline_minute"
        app:layout_constraintBottom_toTopOf="@+id/timeline_second">

        <TextView
            android:id="@+id/flip_screen_saver_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/flip_clock_font"
            android:text="2025.11.20"
            android:textColor="#676767"
            android:textSize="27sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="5dp"
            android:background="#CD0B0B" />

        <TextView
            android:id="@+id/flip_screen_saver_weekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/flip_clock_font"
            android:text="Thu."
            android:textColor="#676767"
            android:textSize="27sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
