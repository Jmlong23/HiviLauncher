<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ai_conversation_background"
    android:clickable="true"
    android:focusable="true">

    <ImageButton
        android:id="@+id/ai_conversation_back"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="start|top"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="7dp"
        android:contentDescription="@string/ai_conversation_back"
        android:padding="11dp"
        android:scaleType="centerInside"
        android:background="@drawable/ic_back" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.hivi.launcher.customview.ParticleVisualizerView
            android:id="@+id/ai_conversation_particle"
            android:layout_width="500dp"
            android:layout_height="320dp"
            android:layout_marginTop="3dp"
            android:contentDescription="@string/ai_conversation_particle"
            android:focusable="true" />

        <TextView
            android:id="@+id/ai_conversation_status"
            android:layout_width="620dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="-5dp"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:text="@string/ai_conversation_welcome"
            android:textColor="@color/text_color"
            android:textSize="24sp" />

        <HorizontalScrollView
            android:id="@+id/ai_conversation_hint_scroll"
            android:layout_width="620dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <TextView
                android:id="@+id/ai_conversation_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="620dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/text_color2"
                android:textSize="13sp" />
        </HorizontalScrollView>
    </LinearLayout>

</FrameLayout>
