<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="460dp"
    android:layout_height="225dp"
    android:background="@drawable/dialog_background"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingLeft="36dp"
    android:paddingTop="24dp"
    android:paddingRight="36dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/system_update_confirm_title"
        android:textColor="@color/text_color"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/system_update_confirmation_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:textColor="@color/text_color"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="59dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/system_update_confirmation_cancel"
            android:layout_width="118dp"
            android:layout_height="36dp"
            android:background="@drawable/secondary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/auth_cancel_action"
            android:textColor="@color/text_color"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/system_update_confirmation_confirm"
            android:layout_width="118dp"
            android:layout_height="36dp"
            android:layout_marginLeft="48dp"
            android:background="@drawable/primary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/system_update_confirm_action"
            android:textColor="@color/text_color"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
