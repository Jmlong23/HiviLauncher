<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/first_use_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#363636"
    android:paddingLeft="89dp"
    android:paddingTop="61dp"
    android:paddingRight="89dp"
    android:paddingBottom="30dp">

    <LinearLayout
        android:id="@+id/first_use_page_language"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/onboarding_welcome_title"
            android:textColor="@color/white"
            android:textSize="43sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:includeFontPadding="false"
            android:text="@string/onboarding_welcome_subtitle"
            android:textColor="@color/text_color"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:layout_marginTop="62dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/first_use_language_chinese"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/settings_menu_item_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/onboarding_language_chinese_label"
                    android:textColor="@color/text_color"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/first_use_language_english"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="67dp"
                android:background="@drawable/settings_menu_item_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/onboarding_language_english_label"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/first_use_language_continue"
            android:layout_width="117dp"
            android:layout_height="42dp"
            android:layout_marginTop="145dp"
            android:layout_marginLeft="555dp"
            android:background="@drawable/primary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/onboarding_continue"
            android:textColor="@color/text_color"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/first_use_page_wifi"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_wifi_title"
            android:textColor="@color/text_color"
            android:textSize="43sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:orientation="horizontal"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_wifi_subtitle"
                android:textColor="@color/text_color"
                android:textSize="15sp" />
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/ic_btn_refresh_bg">
                <ImageView
                    android:id="@+id/first_use_wifi_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:contentDescription="@string/settings_wifi_refresh"
                    android:focusable="true"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_refresh"
                    android:padding="5dp"/>
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="254dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/settings_content_background">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/first_use_wifi_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingLeft="32dp"
                android:paddingTop="21dp"
                android:paddingRight="32dp"
                android:paddingBottom="14dp" />

            <LinearLayout
                android:id="@+id/first_use_wifi_loading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/first_use_wifi_loading_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_loading" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:includeFontPadding="false"
                    android:text="@string/onboarding_wifi_scanning"
                    android:textColor="@color/text_color"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/first_use_wifi_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingLeft="42dp"
                android:paddingRight="42dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_wifi_off" />

                <TextView
                    android:id="@+id/first_use_wifi_empty_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="#B3FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">
            <TextView
                android:id="@+id/first_use_wifi_back"
                android:layout_width="96dp"
                android:layout_height="42dp"
                android:background="@drawable/secondary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/onboarding_back"
                android:textColor="@color/text_color"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/first_use_wifi_skip"
                android:layout_width="220dp"
                android:layout_height="42dp"
                android:background="@drawable/secondary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:layout_marginLeft="20dp"
                android:text="@string/onboarding_wifi_skip"
                android:textColor="@color/text_color"
                android:textSize="15sp" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/first_use_page_wifi_connecting"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/first_use_wifi_connecting_network"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_color"
            android:textSize="31sp" />

        <TextView
            android:layout_width="167dp"
            android:layout_height="167dp"
            android:layout_marginTop="39dp"
            android:includeFontPadding="false"
            android:text="@string/onboarding_wifi_connecting_title"
            android:textColor="@color/text_color"
            android:textSize="19sp"
            android:textStyle="bold"
            android:background="@drawable/wifi_connection_bg"
            android:gravity="center"/>

        <TextView
            android:id="@+id/first_use_wifi_connecting_step"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="47dp"
            android:includeFontPadding="false"
            android:text="@string/onboarding_wifi_connecting_step"
            android:textColor="@color/text_color"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:text="@string/onboarding_wifi_connecting_step_hint"
            android:textColor="@color/text_color"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/first_use_wifi_connecting_cancel"
            android:layout_width="147dp"
            android:layout_height="42dp"
            android:layout_marginTop="35dp"
            android:background="@drawable/secondary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/onboarding_cancel_connection"
            android:textColor="@color/text_color"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/first_use_page_wifi_failed"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="349dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/dialog_background">
            <ImageView
                android:layout_width="115dp"
                android:layout_height="115dp"
                android:background="@drawable/ic_fail"/>
            <TextView
                android:id="@+id/first_use_wifi_failed_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                android:includeFontPadding="false"
                android:textColor="@color/text_color"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/first_use_wifi_failed_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:gravity="center"
                android:textColor="@color/text_color2"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginTop="29dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/first_use_wifi_failed_retry"
                    android:layout_width="176dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/primary_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/onboarding_wifi_reenter_password"
                    android:textColor="@color/text_color"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/first_use_wifi_failed_other_network"
                    android:layout_width="176dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="67dp"
                    android:background="@drawable/secondary_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/onboarding_wifi_other_network"
                    android:textColor="@color/text_color"
                    android:textSize="15sp" />
            </LinearLayout>

        </LinearLayout>


        <TextView
            android:id="@+id/first_use_wifi_failed_skip"
            android:layout_width="220dp"
            android:layout_height="42dp"
            android:layout_marginTop="34dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/onboarding_wifi_skip"
            android:textColor="@color/text_color"
            android:textSize="15sp"
            android:background="@drawable/secondary_button" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/first_use_page_volume"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_volume_title"
            android:textColor="@color/text_color"
            android:textSize="43sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/onboarding_volume_subtitle"
            android:textColor="@color/text_color"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="25dp"
            android:background="@drawable/first_use_volume_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="63dp"
            android:paddingRight="63dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/onboarding_amplifier_volume"
                    android:textColor="@color/text_color"
                    android:textSize="27sp" />

                <TextView
                    android:id="@+id/first_use_volume_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#4C8EFF"
                    android:textSize="31sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="41dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/first_use_volume_mute"
                    android:layout_width="54dp"
                    android:layout_height="45dp"
                    android:clickable="true"
                    android:contentDescription="@string/main_volume_mute"
                    android:focusable="true"
                    android:src="@drawable/volume_mute_button_icon" />

                <ImageView
                    android:id="@+id/first_use_volume_down"
                    android:layout_width="54dp"
                    android:layout_height="45dp"
                    android:layout_marginLeft="18dp"
                    android:clickable="true"
                    android:contentDescription="@string/main_volume_down"
                    android:focusable="true"
                    android:src="@drawable/volume_down_button_icon" />

                <SeekBar
                    android:id="@+id/first_use_volume_seek"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:progressDrawable="@drawable/volume_seek_progress"
                    android:splitTrack="false"
                    android:thumb="@drawable/volume_seek_thumb"
                    android:thumbOffset="0dp" />

                <ImageView
                    android:id="@+id/first_use_volume_up"
                    android:layout_width="54dp"
                    android:layout_height="45dp"
                    android:clickable="true"
                    android:contentDescription="@string/main_volume_up"
                    android:focusable="true"
                    android:src="@drawable/volume_up_button_icon" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="27dp">
            <TextView
                android:id="@+id/first_use_volume_back"
                android:layout_width="117dp"
                android:layout_height="42dp"
                android:background="@drawable/secondary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/onboarding_back"
                android:textColor="@color/text_color"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/first_use_volume_continue"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/primary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/onboarding_volume_continue"
                android:textColor="@color/text_color"
                android:textSize="15sp"
                android:layout_marginLeft="20dp"
                android:paddingRight="20dp"
                android:paddingLeft="20dp"/>
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/first_use_page_input_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_input_mode_title"
            android:textColor="@color/text_color"
            android:textSize="43sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/onboarding_input_mode_subtitle"
            android:textColor="@color/text_color"
            android:textSize="15sp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="241dp"
            android:layout_marginTop="34dp"
            android:columnCount="4"
            android:rowCount="2">

            <FrameLayout
                android:layout_width="158dp"
                android:layout_height="108dp"
                android:layout_gravity="fill"
                android:layout_marginRight="13dp"
                android:layout_marginBottom="25dp"
                android:clickable="true"
                android:contentDescription="@string/input_mode_line"
                android:focusable="true">

                <ImageView
                    android:id="@+id/first_use_input_mode_line"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15dp"
                    android:layout_marginTop="14dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/input_mode_line"
                    android:textColor="@color/text_color"
                    android:textSize="13sp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="21dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginLeft="13dp"
                    android:layout_marginBottom="11dp"
                    android:background="@drawable/status_background"
                    android:gravity="center"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:text="@string/input_mode_status_no_signal"
                    android:textColor="@color/text_color2"
                    android:textSize="13sp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="158dp"
                android:layout_height="108dp"
                android:layout_gravity="fill"
                android:layout_marginRight="13dp"
                android:layout_marginBottom="25dp"
                android:clickable="true"
                android:contentDescription="@string/input_mode_microphone"
                android:focusable="true">

                <ImageView
                    android:id="@+id/first_use_input_mode_microphone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15dp"
                    android:layout_marginTop="14dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/input_mode_microphone"
                    android:textColor="@color/text_color"
                    android:textSize="13sp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="21dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginLeft="13dp"
                    android:layout_marginBottom="11dp"
                    android:background="@drawable/status_background"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:text="@string/input_mode_status_no_signal"
                    android:textColor="@color/text_color2"
                    android:textSize="13sp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="158dp"
                android:layout_height="108dp"
                android:layout_gravity="fill"
                android:layout_marginRight="13dp"
                android:layout_marginBottom="25dp"
                android:clickable="true"
                android:contentDescription="@string/input_mode_optical"
                android:focusable="true">

                <ImageView
                    android:id="@+id/first_use_input_mode_optical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15dp"
                    android:layout_marginTop="14dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/input_mode_optical"
                    android:textColor="@color/text_color"
                    android:textSize="13sp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="21dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginLeft="13dp"
                    android:layout_marginBottom="11dp"
                    android:background="@drawable/status_background"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:text="@string/input_mode_status_no_signal"
                    android:textColor="@color/text_color2"
                    android:textSize="13sp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="158dp"
                android:layout_height="108dp"
                android:layout_gravity="fill"
                android:layout_marginBottom="25dp"
                android:clickable="true"
                android:contentDescription="@string/input_mode_coax"
                android:focusable="true">

                <ImageView
                    android:id="@+id/first_use_input_mode_coax"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15dp"
                    android:layout_marginTop="14dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="@string/input_mode_coax"
                    android:textColor="@color/text_color"
                    android:textSize="13sp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="21dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginLeft="13dp"
                    android:layout_marginBottom="11dp"
                    android:background="@drawable/status_background"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:text="@string/input_mode_status_no_signal"
                    android:textColor="@color/text_color2"
                    android:textSize="13sp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="158dp"
                android:layout_height="108dp"
                android:layout_gravity="fill"
                android:layout_marginRight="13dp"
                android:clickable="true"
                android:contentDescription="@string/input_mode_hdmi"
                android:focusable="true">

                <ImageView
                    android:id="@+id/first_use_input_mode_hdmi"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15dp"
                    android:layout_marginTop="14dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="@string/input_mode_hdmi"
                    android:textColor="@color/text_color"
                    android:textSize="13sp" />



                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="21dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginLeft="13dp"
                    android:layout_marginBottom="11dp"
                    android:background="@drawable/status_background"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:text="@string/input_mode_status_no_signal"
                    android:textColor="@color/text_color2"
                    android:textSize="13sp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="158dp"
                android:layout_height="108dp"
                android:layout_gravity="fill"
                android:layout_marginRight="13dp"
                android:clickable="true"
                android:contentDescription="@string/input_mode_bluetooth"
                android:focusable="true">

                <ImageView
                    android:id="@+id/first_use_input_mode_bluetooth"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15dp"
                    android:layout_marginTop="14dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/input_mode_bluetooth"
                    android:textColor="@color/text_color"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/first_use_input_mode_bluetooth_status"
                    android:layout_width="wrap_content"
                    android:layout_height="21dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginLeft="13dp"
                    android:layout_marginBottom="11dp"
                    android:background="@drawable/status_background"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:textColor="@color/text_color2"
                    android:textSize="13sp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="158dp"
                android:layout_height="108dp"
                android:layout_marginRight="13dp"
                android:layout_gravity="fill"
                android:clickable="true"
                android:contentDescription="@string/input_mode_wifi_music"
                android:focusable="true">

                <ImageView
                    android:id="@+id/first_use_input_mode_wifi"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15dp"
                    android:layout_marginTop="14dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="@string/input_mode_wifi_music"
                    android:textColor="@color/text_color"
                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/first_use_input_mode_wifi_status"
                    android:layout_width="wrap_content"
                    android:layout_height="21dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginLeft="13dp"
                    android:layout_marginBottom="11dp"
                    android:background="@drawable/status_background"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:textColor="@color/text_color2"
                    android:textSize="13sp" />
            </FrameLayout>
        </GridLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp">
            <TextView
                android:id="@+id/first_use_input_mode_back"
                android:layout_width="117dp"
                android:layout_height="42dp"
                android:background="@drawable/secondary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/onboarding_back"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:layout_toLeftOf="@+id/first_use_input_mode_continue"/>

            <TextView
                android:id="@+id/first_use_input_mode_continue"
                android:layout_width="147dp"
                android:layout_height="42dp"
                android:background="@drawable/primary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/onboarding_enter_home"
                android:textColor="@color/text_color"
                android:textSize="15sp"
                android:layout_alignParentRight="true"
                android:layout_marginLeft="20dp"/>
        </RelativeLayout>

    </LinearLayout>

</FrameLayout>
