<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:layout_width="139dp"
            android:layout_height="0.5dp"
            android:layout_marginEnd="14dp"
            android:background="@color/line_color" />

        <TextView
            android:id="@+id/page_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_color"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="139dp"
            android:layout_height="0.5dp"
            android:layout_marginStart="14dp"
            android:background="@color/line_color" />
    </LinearLayout>

    <TextView
        android:id="@+id/bluetooth_status"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/status_background"
        android:gravity="center"
        android:minWidth="76dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="@string/bluetooth_status_disconnected"
        android:textColor="@color/status_disconnect"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="245dp"
        android:layout_marginStart="34dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="212dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginTop="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="138dp"
                android:background="@drawable/bluetooth_page_bg"
                android:orientation="vertical"
                android:paddingStart="21dp"
                android:paddingTop="21dp"
                android:paddingEnd="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bluetooth_connected_device"
                    android:textColor="@color/text_color"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/connected_device_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/bluetooth_device_disconnected"
                    android:textColor="@color/text_color"
                    android:textSize="19sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="27dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bluetooth_signal_strength"
                        android:textColor="@color/text_color"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/signal_strength_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bluetooth_signal_unavailable"
                        android:textColor="@color/text_color"
                        android:textSize="13sp"
                        android:layout_marginLeft="19dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="83dp"
                android:layout_marginTop="21dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/disconnect_button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bluetooth_page_action_bg"
                    android:clickable="true"
                    android:contentDescription="@string/bluetooth_disconnect"
                    android:drawableTop="@drawable/ic_bluetooth_disconnect"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/bluetooth_disconnect"
                    android:textColor="@color/text_color"
                    android:textSize="13sp"
                    android:layout_marginRight="16dp"/>


                <TextView
                    android:id="@+id/reset_button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bluetooth_page_action_bg"
                    android:clickable="true"
                    android:contentDescription="@string/bluetooth_reset"
                    android:drawableTop="@drawable/ic_bluetooth_reset"
                    android:paddingBottom="16dp"
                    android:paddingTop="16dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/bluetooth_reset"
                    android:textColor="@color/text_color"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginLeft="12dp">
            
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="104dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="99dp"
                    android:background="@drawable/bluetooth_page_long_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_alignParentBottom="true"
                    android:paddingRight="15dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="129dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/track_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/bluetooth_no_playback"
                            android:textColor="@color/white"
                            android:textSize="21sp" />

                        <TextView
                            android:id="@+id/track_artist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/bluetooth_unknown_artist"
                            android:textColor="@color/text_color2"
                            android:textSize="19sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btn_play_or_pause"
                        android:layout_width="47dp"
                        android:layout_height="47dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:src="@drawable/ic_pause" />
                    <ImageView
                        android:id="@+id/btn_next_song"
                        android:layout_width="47dp"
                        android:layout_height="47dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:src="@drawable/ic_play_next"
                        android:layout_marginLeft="21dp"/>
                </LinearLayout>
                <RelativeLayout
                    android:layout_width="77dp"
                    android:layout_height="96dp"
                    android:layout_marginLeft="18dp"
                    android:background="@drawable/album_placeholder">
                    <ImageView
                        android:id="@+id/album_artwork"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/avatar_placeholder"
                        android:scaleType="centerCrop"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="41dp"
                        android:contentDescription="@string/bluetooth_album_art"/>
                </RelativeLayout>

            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/bluetooth_page_long_bg"
                android:orientation="vertical"
                android:paddingLeft="24dp"
                android:paddingTop="18dp"
                android:paddingRight="22dp"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/main_amplifier_volume"
                        android:textColor="@color/text_color"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/volume_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#4C8EFF"
                        android:textSize="23sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/volume_mute_button"
                        android:layout_width="40dp"
                        android:layout_height="33dp"
                        android:clickable="true"
                        android:contentDescription="@string/main_volume_mute"
                        android:focusable="true"
                        android:scaleType="centerInside"
                        android:src="@drawable/volume_mute_button_icon" />

                    <ImageView
                        android:id="@+id/volume_down_button"
                        android:layout_width="40dp"
                        android:layout_height="33dp"
                        android:layout_marginLeft="17dp"
                        android:clickable="true"
                        android:contentDescription="@string/main_volume_down"
                        android:focusable="true"
                        android:scaleType="centerInside"
                        android:src="@drawable/volume_down_button_icon" />

                    <SeekBar
                        android:id="@+id/volume_seek_bar"
                        android:layout_width="0dp"
                        android:layout_height="25dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:paddingLeft="0dp"
                        android:paddingRight="0dp"
                        android:progressDrawable="@drawable/volume_seek_progress"
                        android:splitTrack="false"
                        android:thumb="@drawable/volume_seek_thumb"
                        android:thumbOffset="0dp" />

                    <ImageView
                        android:id="@+id/volume_up_button"
                        android:layout_width="40dp"
                        android:layout_height="33dp"
                        android:clickable="true"
                        android:contentDescription="@string/main_volume_up"
                        android:focusable="true"
                        android:scaleType="centerInside"
                        android:src="@drawable/volume_up_button_icon" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
