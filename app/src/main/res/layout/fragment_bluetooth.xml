<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:layout_width="139dp"
            android:layout_height="0.5dp"
            android:layout_marginEnd="14dp"
            android:background="@color/line_color" />

        <TextView
            android:id="@+id/page_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_color"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="139dp"
            android:layout_height="0.5dp"
            android:layout_marginStart="14dp"
            android:background="@color/line_color" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="247dp"
        android:layout_marginStart="34dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="34dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="106dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="212dp"
                android:layout_height="83dp"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/disconnect_button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bluetooth_page_action_bg"
                    android:clickable="true"
                    android:contentDescription="@string/bluetooth_disconnect"
                    android:drawableTop="@drawable/ic_bluetooth_disconnect"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:text="@string/bluetooth_disconnect"
                    android:textColor="@color/text_color"
                    android:textSize="13sp"
                    android:layout_marginRight="16dp" />

                <TextView
                    android:id="@+id/reset_button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bluetooth_page_action_bg"
                    android:clickable="true"
                    android:contentDescription="@string/bluetooth_reset"
                    android:drawableTop="@drawable/ic_bluetooth_reset"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:text="@string/bluetooth_reset"
                    android:textColor="@color/text_color"
                    android:textSize="13sp" />
            </LinearLayout>

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="99dp"
                    android:background="@drawable/bluetooth_page_long_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_alignParentBottom="true"
                    android:paddingRight="15dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="129dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/track_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/bluetooth_no_playback"
                            android:textColor="@color/white"
                            android:textSize="21sp" />

                        <TextView
                            android:id="@+id/track_artist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/bluetooth_unknown_artist"
                            android:textColor="@color/text_color2"
                            android:textSize="19sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btn_previous_song"
                        android:layout_width="47dp"
                        android:layout_height="47dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:src="@drawable/ic_play_prv"
                        android:layout_marginRight="21dp" />

                    <ImageView
                        android:id="@+id/btn_play_or_pause"
                        android:layout_width="47dp"
                        android:layout_height="47dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:src="@drawable/ic_pause" />

                    <ImageView
                        android:id="@+id/btn_next_song"
                        android:layout_width="47dp"
                        android:layout_height="47dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:src="@drawable/ic_play_next"
                        android:layout_marginLeft="21dp" />
                </LinearLayout>

                <RelativeLayout
                    android:layout_width="77dp"
                    android:layout_height="96dp"
                    android:layout_marginLeft="18dp"
                    android:background="@drawable/album_placeholder">

                    <ImageView
                        android:id="@+id/album_artwork"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/avatar_placeholder"
                        android:scaleType="centerCrop"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="41dp"
                        android:contentDescription="@string/bluetooth_album_art" />
                </RelativeLayout>
            </RelativeLayout>
        </LinearLayout>

        <com.hivi.launcher.customview.AudioSpectrumView
            android:id="@+id/bluetooth_visualizer_panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_weight="1"
            android:background="@drawable/mode_rhythm_bg" />
    </LinearLayout>
</LinearLayout>
