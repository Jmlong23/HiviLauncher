<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="500dp"
    android:layout_height="120dp"
    android:background="@drawable/dialog_background"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingTop="18dp"
    android:paddingRight="22dp"
    android:paddingBottom="21dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/main_amplifier_volume"
            android:textColor="@color/text_color"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/volume_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="#4C8EFF"
            android:textSize="23sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/volume_mute_button"
            android:layout_width="40dp"
            android:layout_height="33dp"
            android:clickable="true"
            android:contentDescription="@string/main_volume_mute"
            android:focusable="true"
            android:scaleType="centerInside"
            android:src="@drawable/volume_mute_button_icon" />

        <ImageView
            android:id="@+id/volume_down_button"
            android:layout_width="40dp"
            android:layout_height="33dp"
            android:layout_marginLeft="17dp"
            android:clickable="true"
            android:contentDescription="@string/main_volume_down"
            android:focusable="true"
            android:scaleType="centerInside"
            android:src="@drawable/volume_down_button_icon" />

        <SeekBar
            android:id="@+id/volume_seek_bar"
            android:layout_width="0dp"
            android:layout_height="25dp"
            android:layout_weight="1"
            android:max="100"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:progressDrawable="@drawable/volume_seek_progress"
            android:splitTrack="false"
            android:thumb="@drawable/volume_seek_thumb"
            android:thumbOffset="0dp" />

        <ImageView
            android:id="@+id/volume_up_button"
            android:layout_width="40dp"
            android:layout_height="33dp"
            android:clickable="true"
            android:contentDescription="@string/main_volume_up"
            android:focusable="true"
            android:scaleType="centerInside"
            android:src="@drawable/volume_up_button_icon" />
    </LinearLayout>
</LinearLayout>
