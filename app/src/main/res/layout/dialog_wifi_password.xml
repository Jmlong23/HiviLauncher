<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/settings_wifi_dialog_background"
    android:orientation="vertical"
    android:paddingLeft="68dp"
    android:paddingTop="24dp"
    android:paddingRight="68dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/wifi_password_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/text_color"
        android:textSize="24sp" />

    <EditText
        android:id="@+id/wifi_password_input"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/settings_wifi_password_input_background"
        android:hint="@string/settings_wifi_password_hint"
        android:imeOptions="actionDone"
        android:inputType="textPassword"
        android:paddingLeft="21dp"
        android:paddingRight="21dp"
        android:singleLine="true"
        android:textColor="@color/text_color"
        android:textColorHint="@color/text_color2"
        android:textCursorDrawable="@null"
        android:textSize="15sp" />

    <CheckBox
        android:id="@+id/wifi_password_show"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:buttonTint="@color/text_color"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:text="@string/settings_wifi_show_password"
        android:textColor="@color/text_color2"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="9dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wifi_password_connect"
            android:layout_width="143dp"
            android:layout_height="41dp"
            android:background="@drawable/settings_wifi_primary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/settings_wifi_connect"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="56dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/wifi_password_cancel"
            android:layout_width="143dp"
            android:layout_height="41dp"
            android:background="@drawable/settings_wifi_secondary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/settings_wifi_cancel"
            android:textColor="@color/text_color"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
