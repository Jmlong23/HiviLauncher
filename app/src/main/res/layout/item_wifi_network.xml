<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wifi_network_item"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginBottom="9dp"
    android:background="@drawable/settings_wifi_network_item_background"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:id="@+id/wifi_network_check"
            android:layout_width="25dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="&#x2713;"
            android:textColor="#5288DD"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/wifi_network_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/text_color"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/wifi_network_progress"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:indeterminateTint="#5288DD"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/wifi_network_signal"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:contentDescription="@null"
            android:scaleType="centerInside"
            android:src="@drawable/ic_wifi" />
    </LinearLayout>
</FrameLayout>
