<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="765dp"
    android:layout_height="373dp"
    android:background="@drawable/dialog_background"
    android:orientation="vertical"
    android:paddingLeft="25dp"
    android:paddingTop="31dp"
    android:paddingRight="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/input_mode_dialog_back"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/auth_back"
            android:scaleType="centerInside"
            android:background="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="37dp"
            android:text="@string/input_mode_dialog_title"
            android:textColor="@color/text_color"
            android:textSize="21sp" />
    </LinearLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="241dp"
        android:layout_marginTop="34dp"
        android:columnCount="4"
        android:rowCount="2">

        <FrameLayout
            android:id="@+id/input_mode_dialog_line"
            android:layout_width="169dp"
            android:layout_height="108dp"
            android:layout_gravity="fill"
            android:layout_marginRight="13dp"
            android:layout_marginBottom="25dp"
            android:clickable="true"
            android:contentDescription="@string/input_mode_line"
            android:focusable="true">

            <ImageView
                android:id="@+id/input_mode_dialog_line_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="14dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/input_mode_line"
                android:textColor="@color/text_color"
                android:textSize="13sp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="21dp"
                android:layout_gravity="bottom|start"
                android:layout_marginLeft="13dp"
                android:layout_marginBottom="11dp"
                android:background="@drawable/status_background"
                android:gravity="center"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:text="@string/input_mode_status_no_signal"
                android:textColor="@color/text_color"
                android:textSize="13sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/input_mode_dialog_microphone"
            android:layout_width="169dp"
            android:layout_height="108dp"
            android:layout_gravity="fill"
            android:layout_marginRight="13dp"
            android:layout_marginBottom="25dp"
            android:clickable="true"
            android:contentDescription="@string/input_mode_microphone"
            android:focusable="true">

            <ImageView
                android:id="@+id/input_mode_dialog_microphone_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="14dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/input_mode_microphone"
                android:textColor="@color/text_color"
                android:textSize="13sp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="21dp"
                android:layout_gravity="bottom|start"
                android:layout_marginLeft="13dp"
                android:layout_marginBottom="11dp"
                android:background="@drawable/status_background"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:text="@string/input_mode_status_no_signal"
                android:textColor="@color/text_color"
                android:textSize="13sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/input_mode_dialog_optical"
            android:layout_width="169dp"
            android:layout_height="108dp"
            android:layout_gravity="fill"
            android:layout_marginRight="13dp"
            android:layout_marginBottom="25dp"
            android:clickable="true"
            android:contentDescription="@string/input_mode_optical"
            android:focusable="true">

            <ImageView
                android:id="@+id/input_mode_dialog_optical_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="14dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/input_mode_optical"
                android:textColor="@color/text_color"
                android:textSize="13sp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="21dp"
                android:layout_gravity="bottom|start"
                android:layout_marginLeft="13dp"
                android:layout_marginBottom="11dp"
                android:background="@drawable/status_background"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:text="@string/input_mode_status_no_signal"
                android:textColor="@color/text_color"
                android:textSize="13sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/input_mode_dialog_coax"
            android:layout_width="169dp"
            android:layout_height="108dp"
            android:layout_gravity="fill"
            android:layout_marginBottom="25dp"
            android:clickable="true"
            android:contentDescription="@string/input_mode_coax"
            android:focusable="true">

            <ImageView
                android:id="@+id/input_mode_dialog_coax_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="14dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="@string/input_mode_coax"
                android:textColor="@color/text_color"
                android:textSize="13sp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="21dp"
                android:layout_gravity="bottom|start"
                android:layout_marginLeft="13dp"
                android:layout_marginBottom="11dp"
                android:background="@drawable/status_background"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:text="@string/input_mode_status_no_signal"
                android:textColor="@color/text_color"
                android:textSize="13sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/input_mode_dialog_hdmi"
            android:layout_width="169dp"
            android:layout_height="108dp"
            android:layout_gravity="fill"
            android:layout_marginRight="13dp"
            android:clickable="true"
            android:contentDescription="@string/input_mode_hdmi"
            android:focusable="true">

            <ImageView
                android:id="@+id/input_mode_dialog_hdmi_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="14dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="@string/input_mode_hdmi"
                android:textColor="@color/text_color"
                android:textSize="13sp" />



            <TextView
                android:layout_width="wrap_content"
                android:layout_height="21dp"
                android:layout_gravity="bottom|start"
                android:layout_marginLeft="13dp"
                android:layout_marginBottom="11dp"
                android:background="@drawable/status_background"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:text="@string/input_mode_status_no_signal"
                android:textColor="@color/text_color"
                android:textSize="13sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/input_mode_dialog_bluetooth"
            android:layout_width="169dp"
            android:layout_height="108dp"
            android:layout_gravity="fill"
            android:layout_marginRight="13dp"
            android:clickable="true"
            android:contentDescription="@string/input_mode_bluetooth"
            android:focusable="true">

            <ImageView
                android:id="@+id/input_mode_dialog_bluetooth_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="14dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/input_mode_bluetooth"
                android:textColor="@color/text_color"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/input_mode_dialog_bluetooth_status"
                android:layout_width="wrap_content"
                android:layout_height="21dp"
                android:layout_gravity="bottom|start"
                android:layout_marginLeft="13dp"
                android:layout_marginBottom="11dp"
                android:background="@drawable/status_background"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:textColor="@color/text_color"
                android:textSize="13sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/input_mode_dialog_wifi"
            android:layout_width="169dp"
            android:layout_height="108dp"
            android:layout_marginRight="13dp"
            android:layout_gravity="fill"
            android:clickable="true"
            android:contentDescription="@string/input_mode_wifi_music"
            android:focusable="true">

            <ImageView
                android:id="@+id/input_mode_dialog_wifi_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="14dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="@string/input_mode_wifi_music"
                android:textColor="@color/text_color"
                android:textSize="13sp" />


            <TextView
                android:id="@+id/input_mode_dialog_wifi_status"
                android:layout_width="wrap_content"
                android:layout_height="21dp"
                android:layout_gravity="bottom|start"
                android:layout_marginLeft="13dp"
                android:layout_marginBottom="11dp"
                android:background="@drawable/status_background"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:textColor="@color/text_color"
                android:textSize="13sp" />
        </FrameLayout>
    </GridLayout>
</LinearLayout>
