<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:layout_width="139dp"
            android:layout_height="0.5dp"
            android:layout_marginRight="14dp"
            android:background="@color/line_color" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/settings_title"
            android:textColor="@color/text_color"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="139dp"
            android:layout_height="0.5dp"
            android:layout_marginLeft="14dp"
            android:background="@color/line_color" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="29dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="283dp"
            android:layout_height="match_parent"
            android:layout_marginRight="37dp"
            android:clipChildren="false"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/settings_tab_network"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/settings_menu_item_background"
                android:clickable="true"
                android:elevation="8dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="21dp"
                android:paddingRight="21dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/settings_network"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/settings_network_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/settings_network_summary"
                    android:textColor="@color/text_color2"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_tab_display"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/settings_menu_item_background"
                android:clickable="true"
                android:elevation="8dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="21dp"
                android:paddingRight="21dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/settings_display"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/settings_display_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/settings_display_summary"
                    android:textColor="@color/text_color2"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_tab_system"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/settings_menu_item_background"
                android:clickable="true"
                android:elevation="8dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="21dp"
                android:paddingRight="21dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/settings_system"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/settings_system_summary_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/settings_system_summary"
                    android:textColor="@color/text_color2"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_tab_about"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/settings_menu_item_background"
                android:clickable="true"
                android:elevation="8dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="21dp"
                android:paddingRight="21dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/settings_about"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/settings_about_summary"
                    android:textColor="@color/text_color2"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_tab_maintenance"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/settings_menu_item_background"
                android:clickable="true"
                android:elevation="8dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="21dp"
                android:paddingRight="21dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/settings_maintenance"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/settings_maintenance_summary"
                    android:textColor="@color/text_color2"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginBottom="25dp">

            <LinearLayout
                android:id="@+id/settings_panel_network"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/settings_content_background"
                android:orientation="vertical"
                android:paddingLeft="26dp"
                android:paddingTop="19dp"
                android:paddingRight="30dp"
                android:paddingBottom="16dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="@string/settings_wifi_network"
                        android:textColor="@color/text_color"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/ic_btn_refresh_bg">

                        <ImageView
                            android:id="@+id/settings_wifi_refresh"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:contentDescription="@string/settings_wifi_refresh"
                            android:focusable="true"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_refresh"
                            android:padding="5dp"/>

                    </FrameLayout>

                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="10dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/settings_wifi_list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:scrollbars="vertical"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/settings_wifi_empty_state"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="79dp"
                            android:layout_height="79dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_wifi_error" />

                        <TextView
                            android:id="@+id/settings_wifi_empty_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="25dp"
                            android:includeFontPadding="false"
                            android:text="@string/settings_no_network_message"
                            android:textColor="@color/text_color"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/settings_wifi_loading"
                        style="?android:attr/progressBarStyleLarge"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="#4E83D8"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <ScrollView
                android:id="@+id/settings_panel_display"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/settings_content_background"
                android:fillViewport="true"
                android:paddingLeft="26dp"
                android:paddingTop="19dp"
                android:paddingRight="33dp"
                android:paddingBottom="31dp"
                android:scrollbars="vertical"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_language"
                        android:textColor="@color/text_color"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/settings_language"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/item_medium_long_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="21dp"
                        android:paddingRight="21dp">

                        <TextView
                            android:id="@+id/settings_language_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:includeFontPadding="false"
                            android:text="@string/settings_language_value"
                            android:textColor="@color/text_color"
                            android:textSize="13sp" />

                        <ImageView
                            android:id="@+id/settings_language_arrow"
                            android:layout_width="13dp"
                            android:layout_height="7dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_dropdown" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="19dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_screensaver"
                            android:textColor="@color/text_color"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/settings_time_screen_saver"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/item_medium_long_bg"
                        android:clickable="true"
                        android:enabled="false"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="21dp"
                        android:paddingRight="21dp">

                        <TextView
                            android:id="@+id/settings_time_screen_saver_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_screensaver_timeout_value"
                            android:textColor="@color/text_color"
                            android:textSize="13sp" />

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="7dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_dropdown" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/settings_screensaver_style"
                        android:textColor="@color/text_color"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="17dp"
                        android:orientation="vertical">

                        <!-- Row 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="138dp"
                            android:orientation="horizontal">

                            <!-- Item 1: Simple Clock -->
                            <FrameLayout
                                android:id="@+id/screensaver_item_simple"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginEnd="21dp"
                                android:background="@drawable/bg_screensaver_item"
                                android:clickable="true"
                                android:focusable="true">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="8dp">

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1">

                                    <ImageView
                                        android:id="@+id/screensaver_thumbnail_simple"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="@drawable/bg_screensaver_thumbnail"
                                        android:scaleType="centerCrop" />

                                    <ImageView
                                        android:id="@+id/screensaver_thumbnail_simple_clock"
                                        android:layout_width="97dp"
                                        android:layout_height="54dp"
                                        android:contentDescription="@null"
                                        android:layout_gravity="center_horizontal"/>
                                </FrameLayout>


                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:text="@string/settings_screensaver_style_simple"
                                        android:textColor="@color/text_color"
                                        android:textSize="14sp" />
                                </LinearLayout>

                                <ImageView
                                    android:id="@+id/screensaver_check_simple"
                                    android:layout_width="23dp"
                                    android:layout_height="23dp"
                                    android:layout_gravity="top|end"
                                    android:layout_marginTop="15dp"
                                    android:layout_marginEnd="15dp"
                                    android:src="@drawable/ic_screensaver_check"
                                    android:visibility="gone" />
                            </FrameLayout>

                            <!-- Item 2: Weather Clock -->
                            <FrameLayout
                                android:id="@+id/screensaver_item_weather"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/bg_screensaver_item"
                                android:clickable="true"
                                android:focusable="true">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="8dp">

                                    <ImageView
                                        android:id="@+id/screensaver_thumbnail_weather"
                                        android:layout_width="match_parent"
                                        android:layout_height="0dp"
                                        android:layout_weight="1"
                                        android:background="@drawable/bg_screensaver_thumbnail"
                                        android:scaleType="centerCrop" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:text="@string/settings_screensaver_style_weather"
                                        android:textColor="@color/text_color"
                                        android:textSize="14sp" />
                                </LinearLayout>

                                <ImageView
                                    android:id="@+id/screensaver_check_weather"
                                    android:layout_width="23dp"
                                    android:layout_height="23dp"
                                    android:layout_gravity="top|end"
                                    android:layout_marginTop="15dp"
                                    android:layout_marginEnd="15dp"
                                    android:src="@drawable/ic_screensaver_check"
                                    android:visibility="gone" />
                            </FrameLayout>
                        </LinearLayout>

                        <!-- Row 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="138dp"
                            android:layout_marginTop="11dp"
                            android:orientation="horizontal">

                            <!-- Item 3: Flip Clock -->
                            <FrameLayout
                                android:id="@+id/screensaver_item_flip"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginEnd="21dp"
                                android:background="@drawable/bg_screensaver_item"
                                android:clickable="true"
                                android:focusable="true">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="8dp">

                                    <ImageView
                                        android:id="@+id/screensaver_thumbnail_flip"
                                        android:layout_width="match_parent"
                                        android:layout_height="0dp"
                                        android:layout_weight="1"
                                        android:background="@drawable/bg_screensaver_thumbnail"
                                        android:scaleType="centerCrop" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:text="@string/settings_screensaver_style_flip"
                                        android:textColor="@color/text_color"
                                        android:textSize="14sp" />
                                </LinearLayout>

                                <ImageView
                                    android:id="@+id/screensaver_check_flip"
                                    android:layout_width="23dp"
                                    android:layout_height="23dp"
                                    android:layout_gravity="top|end"
                                    android:layout_marginTop="15dp"
                                    android:layout_marginEnd="15dp"
                                    android:src="@drawable/ic_screensaver_check"
                                    android:visibility="gone" />
                            </FrameLayout>

                            <!-- Item 4: Black Screen -->
                            <FrameLayout
                                android:id="@+id/screensaver_item_black"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/bg_screensaver_item"
                                android:clickable="true"
                                android:focusable="true">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="8dp">

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="0dp"
                                        android:layout_weight="1"
                                        android:background="@drawable/bg_screensaver_black" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:text="@string/settings_screensaver_style_black"
                                        android:textColor="@color/text_color"
                                        android:textSize="14sp" />
                                </LinearLayout>

                                <ImageView
                                    android:id="@+id/screensaver_check_black"
                                    android:layout_width="23dp"
                                    android:layout_height="23dp"
                                    android:layout_gravity="top|end"
                                    android:layout_marginTop="15dp"
                                    android:layout_marginEnd="15dp"
                                    android:src="@drawable/ic_screensaver_check"
                                    android:visibility="gone" />
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:includeFontPadding="false"
                        android:text="@string/settings_brightness"
                        android:textColor="@color/text_color"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="81dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/item_medium_long_bg"
                        android:paddingRight="30dp"
                        android:paddingLeft="30dp">

                        <SeekBar
                            android:id="@+id/settings_brightness"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_gravity="center_vertical"
                            android:contentDescription="@string/settings_brightness"
                            android:focusable="true"
                            android:max="255"
                            android:paddingLeft="0dp"
                            android:paddingRight="0dp"
                            android:progressDrawable="@drawable/settings_slider_progress"
                            android:splitTrack="false"
                            android:thumb="@drawable/settings_slider_thumb"
                            android:thumbOffset="0dp" />
                    </FrameLayout>
                    </LinearLayout>

            </ScrollView>

            <LinearLayout
                android:id="@+id/settings_panel_system"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/settings_content_background"
                android:orientation="vertical"
                android:paddingLeft="26dp"
                android:paddingTop="19dp"
                android:paddingRight="30dp"
                android:paddingBottom="25dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_system"
                    android:textColor="@color/text_color"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="17dp"
                    android:background="@drawable/item_medium_long_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="21dp"
                    android:paddingRight="21dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_system_update"
                        android:textColor="@color/text_color"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/settings_system_version_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_system_version"
                        android:textColor="@color/text_color2"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/settings_system_update_action"
                        android:layout_width="45dp"
                        android:layout_height="23dp"
                        android:layout_marginLeft="8dp"
                        android:background="@drawable/system_update_action_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/settings_system_update_action"
                        android:textColor="@color/text_color"
                        android:textSize="12sp"
                        android:visibility="gone"
                        android:paddingLeft="3dp"
                        android:paddingRight="3dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/settings_log_upload"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/item_medium_long_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="21dp"
                    android:paddingRight="21dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_log_upload"
                        android:textColor="@color/text_color"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginLeft="9dp"
                        android:src="@drawable/ic_enter" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_panel_about"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/settings_content_background"
                android:orientation="vertical"
                android:paddingLeft="26dp"
                android:paddingTop="19dp"
                android:paddingRight="30dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:text="@string/settings_about"
                    android:textColor="@color/text_color"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/settings_product_information"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="17dp"
                    android:background="@drawable/item_medium_long_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="21dp"
                    android:paddingRight="21dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_product_information"
                        android:textColor="@color/text_color"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_enter" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/item_medium_long_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="21dp"
                    android:paddingRight="21dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_help"
                        android:textColor="@color/text_color"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:src="@drawable/ic_enter" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/item_medium_long_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="21dp"
                    android:paddingRight="21dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_privacy"
                        android:textColor="@color/text_color"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:src="@drawable/ic_enter" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_panel_maintenance"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/settings_content_background"
                android:orientation="vertical"
                android:paddingLeft="26dp"
                android:paddingTop="19dp"
                android:paddingRight="30dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:text="@string/settings_maintenance"
                    android:textColor="@color/text_color"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/settings_restore_factory"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/item_medium_long_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="21dp"
                    android:paddingRight="21dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_restore_factory"
                        android:textColor="@color/text_color"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:src="@drawable/ic_enter" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
