<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_grid_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="108dp"
        android:layout_height="108dp"
        android:background="@drawable/main_music_tile_background"
        android:duplicateParentState="true">

        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <View
            android:id="@+id/app_download_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#44000000"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/app_download"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_download"
            android:visibility="gone" />

        <com.hivi.launcher.customview.AppDownloadProgressView
            android:id="@+id/app_progress"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/app_label"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="@color/text_color"
        android:textSize="24sp" />
</LinearLayout>
