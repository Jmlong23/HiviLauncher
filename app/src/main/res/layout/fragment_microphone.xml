<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:layout_width="139dp"
            android:layout_height="0.5dp"
            android:layout_marginEnd="14dp"
            android:background="@color/line_color" />

        <TextView
            android:id="@+id/page_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/text_color"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="139dp"
            android:layout_height="0.5dp"
            android:layout_marginStart="14dp"
            android:background="@color/line_color" />
    </LinearLayout>

    <TextView
        android:id="@+id/microphone_status"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/status_background"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minWidth="92dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="@string/microphone_status_disconnected"
        android:textColor="@color/status_disconnect"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="268dp"
        android:layout_marginStart="34dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="34dp"
        android:background="@drawable/microphone_panel_bg"
        android:orientation="vertical"
        android:paddingStart="27dp"
        android:paddingTop="29dp"
        android:paddingEnd="23dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/item_long_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_amplifier_volume"
                android:textColor="@color/text_color"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/amplifier_volume_mute_button"
                android:layout_width="40dp"
                android:layout_height="33dp"
                android:clickable="true"
                android:contentDescription="@string/main_volume_mute"
                android:focusable="true"
                android:scaleType="centerInside"
                android:src="@drawable/volume_mute_button_icon"
                android:layout_marginStart="23dp"/>

            <ImageView
                android:id="@+id/amplifier_volume_down_button"
                android:layout_width="40dp"
                android:layout_height="33dp"
                android:layout_marginStart="21dp"
                android:clickable="true"
                android:contentDescription="@string/main_volume_down"
                android:focusable="true"
                android:scaleType="centerInside"
                android:src="@drawable/volume_down_button_icon" />

            <SeekBar
                android:id="@+id/amplifier_volume_seek_bar"
                android:layout_width="0dp"
                android:layout_height="25dp"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:max="100"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progressDrawable="@drawable/volume_seek_progress"
                android:splitTrack="false"
                android:thumb="@drawable/volume_seek_thumb"
                android:thumbOffset="0dp" />

            <ImageView
                android:id="@+id/amplifier_volume_up_button"
                android:layout_width="40dp"
                android:layout_height="33dp"
                android:layout_marginStart="16dp"
                android:clickable="true"
                android:contentDescription="@string/main_volume_up"
                android:focusable="true"
                android:scaleType="centerInside"
                android:src="@drawable/volume_up_button_icon" />

            <TextView
                android:id="@+id/amplifier_volume_value"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="21dp"
                android:gravity="end"
                android:textColor="#4C8EFF"
                android:textSize="23sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/item_long_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="22dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/microphone_volume"
                android:textColor="@color/text_color"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/microphone_volume_mute_button"
                android:layout_width="40dp"
                android:layout_height="33dp"
                android:clickable="true"
                android:contentDescription="@string/main_volume_mute"
                android:focusable="true"
                android:scaleType="centerInside"
                android:src="@drawable/volume_mute_button_icon"
                android:layout_marginStart="23dp" />

            <ImageView
                android:id="@+id/microphone_volume_down_button"
                android:layout_width="40dp"
                android:layout_height="33dp"
                android:layout_marginStart="21dp"
                android:clickable="true"
                android:contentDescription="@string/main_volume_down"
                android:focusable="true"
                android:scaleType="centerInside"
                android:src="@drawable/volume_down_button_icon" />

            <SeekBar
                android:id="@+id/microphone_volume_seek_bar"
                android:layout_width="0dp"
                android:layout_height="25dp"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:max="100"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progressDrawable="@drawable/volume_seek_progress"
                android:splitTrack="false"
                android:thumb="@drawable/volume_seek_thumb"
                android:thumbOffset="0dp" />

            <ImageView
                android:id="@+id/microphone_volume_up_button"
                android:layout_width="40dp"
                android:layout_height="33dp"
                android:layout_marginStart="16dp"
                android:clickable="true"
                android:contentDescription="@string/main_volume_up"
                android:focusable="true"
                android:scaleType="centerInside"
                android:src="@drawable/volume_up_button_icon" />

            <TextView
                android:id="@+id/microphone_volume_value"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="21dp"
                android:gravity="end"
                android:textColor="#4C8EFF"
                android:textSize="23sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/item_long_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="22dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/microphone_effect_volume"
                android:textColor="@color/text_color"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/effect_volume_mute_button"
                android:layout_width="40dp"
                android:layout_height="33dp"
                android:clickable="true"
                android:contentDescription="@string/main_volume_mute"
                android:focusable="true"
                android:scaleType="centerInside"
                android:src="@drawable/volume_mute_button_icon"
                android:layout_marginStart="23dp" />

            <ImageView
                android:id="@+id/effect_volume_down_button"
                android:layout_width="40dp"
                android:layout_height="33dp"
                android:layout_marginStart="21dp"
                android:clickable="true"
                android:contentDescription="@string/main_volume_down"
                android:focusable="true"
                android:scaleType="centerInside"
                android:src="@drawable/volume_down_button_icon" />

            <SeekBar
                android:id="@+id/effect_volume_seek_bar"
                android:layout_width="0dp"
                android:layout_height="25dp"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:max="100"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progressDrawable="@drawable/volume_seek_progress"
                android:splitTrack="false"
                android:thumb="@drawable/volume_seek_thumb"
                android:thumbOffset="0dp" />

            <ImageView
                android:id="@+id/effect_volume_up_button"
                android:layout_width="40dp"
                android:layout_height="33dp"
                android:layout_marginStart="16dp"
                android:clickable="true"
                android:contentDescription="@string/main_volume_up"
                android:focusable="true"
                android:scaleType="centerInside"
                android:src="@drawable/volume_up_button_icon" />

            <TextView
                android:id="@+id/effect_volume_value"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="21dp"
                android:gravity="end"
                android:textColor="#4C8EFF"
                android:textSize="23sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
